menu "WebSocKetHandle (WebSocket client)"

    choice WS_TARGET
        prompt "WebSocket data destination"
        default WS_TARGET_LOCAL
        help
            Select the default destination used by the gateway.

        config WS_TARGET_LOCAL
            bool "Local server (mDNS)"

        config WS_TARGET_SERVER
            bool "Internet server"
    endchoice

    config WS_LOCAL_URL
        string "Local WebSocket URI"
        default "ws://systemmsems.local:9090/ws"
        help
            Local WebSocket server advertised through mDNS as systemmsems.local.

    config WS_SERVER_URL
        string "Internet WebSocket URI"
        default "wss://systemmsems.msems.click/ws"
        help
            Public WebSocket server URI.

endmenu
