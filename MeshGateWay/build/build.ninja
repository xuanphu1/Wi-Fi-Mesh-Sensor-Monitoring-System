  COMMAND = cd /home/phu/esp/esp-idf-v5.2.5/components/app_update && /usr/bin/cmake -D IDF_PATH=/home/phu/esp/esp-idf-v5.2.5 -D "SERIAL_TOOL=/home/phu/.espressif/python_env/idf5.2_py3.10_env/bin/python;;/home/phu/esp/esp-idf-v5.2.5/components/esptool_py/esptool/esptool.py;--chip;esp32" -D "SERIAL_TOOL_ARGS=--before=default_reset;--after=hard_reset;write_flash;@otadata-flash_args" -D WORKING_DIRECTORY=/home/phu/Documents/Phuhx1/Thesis-Project/Wi-Fi-Mesh-Sensor-Monitoring-System/MeshGateWay/build -P /home/phu/esp/esp-idf-v5.2.5/components/esptool_py/run_serial_tool.cmake
  pool = console


#############################################
# Custom command for esp-idf/app_update/CMakeFiles/encrypted-otadata-flash

build esp-idf/app_update/CMakeFiles/encrypted-otadata-flash | ${cmake_ninja_workdir}esp-idf/app_update/CMakeFiles/encrypted-otadata-flash: CUSTOM_COMMAND
  COMMAND = cd /home/phu/Documents/Phuhx1/Thesis-Project/Wi-Fi-Mesh-Sensor-Monitoring-System/MeshGateWay/build/esp-idf/app_update && /usr/bin/cmake -E echo "Error: The target encrypted-otadata-flash requires" && /usr/bin/cmake -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && /usr/bin/cmake -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" /usr/bin/cmake -P /home/phu/esp/esp-idf-v5.2.5/tools/cmake/scripts/fail.cmake

